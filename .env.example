# Copie para .env (local) ou cadastre estas variáveis no painel da hospedagem. Nunca versione o .env.

# Credenciais da aplicação no Dashboard da Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Login do app (obrigatório quando NODE_ENV=production)
APP_USER=marcio
APP_PASSWORD=

# true = mostra conectores sandbox no widget; use false em produção
PLUGGY_INCLUDE_SANDBOX=true

# A hospedagem normalmente define PORT sozinha
PORT=3000
