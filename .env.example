# Modelo das variáveis de ambiente. Copie para .env (uso local; o servidor carrega o arquivo
# sozinho no Node 20.12+) ou cadastre no painel da hospedagem. Nunca versione o .env.
# Variáveis já definidas no ambiente têm precedência sobre o .env.

# --- Credenciais da aplicação no Dashboard da Pluggy (https://dashboard.pluggy.ai) ---
# Ficam só no servidor. Em produção são obrigatórias aqui: sem elas o servidor não sobe
# (e o app não aceita digitar na tela).
# Em desenvolvimento, sem elas, a tela de conexão pede Client ID/Secret (validados antes de gravar).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Login do app (HTTP Basic) ---
# APP_USER também é o clientUserId enviado à Pluggy (sem senha, o servidor usa "local-dev").
APP_USER=marcio
# Obrigatória com NODE_ENV=production (e no Render, que define RENDER=true), mínimo de 12 caracteres.
# Vazia = sem login, só para uso local: escuta em 127.0.0.1 e só atende pedidos para localhost.
APP_PASSWORD=

# --- Ambiente ---
# production: exige APP_PASSWORD (12+) e as chaves da Pluggy, desliga o sandbox por padrão, liga o HSTS,
# recusa credenciais digitadas na tela e ignora as variáveis "só desenvolvimento" do fim do arquivo.
# NODE_ENV=production

# Conectores de teste da Pluggy no widget (Pluggy Bank, Pluggy Bank Business, Pluggy Bank Investment).
# Padrão: ligado fora de produção e desligado em produção. Use "true" ou "false" para forçar.
# PLUGGY_INCLUDE_SANDBOX=true

# --- Rede ---
# Quantos proxies confiáveis acrescentam IP no X-Forwarded-For (limite de senhas erradas por IP).
# 0 = ignora o cabeçalho e usa o IP da conexão (local, Docker ou VPS sem proxy na frente).
# No Render use o valor do render.yaml (veja "Descobrir TRUST_PROXY_HOPS" no README).
TRUST_PROXY_HOPS=0

# Interface de escuta. Padrão: 127.0.0.1 sem APP_PASSWORD e 0.0.0.0 com senha.
# Sem senha, mesmo com outro HOST, o app só atende pedidos endereçados a localhost (os demais levam 403).
# O Dockerfile e o render.yaml já definem 0.0.0.0.
# HOST=127.0.0.1

# Porta HTTP. A hospedagem normalmente define PORT sozinha.
PORT=3000

# --- Só desenvolvimento/testes (ignoradas com NODE_ENV=production) ---
# Aponta para uma Pluggy falsa local, timeout das chamadas (ms) e espera máxima por um Item em UPDATING (ms).
# PLUGGY_API_URL=http://127.0.0.1:4010
# PLUGGY_TIMEOUT_MS=20000
# PLUGGY_POLL_MAX_MS=25000
